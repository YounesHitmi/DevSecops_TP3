{
  "type": "project",
  "description": "Simple PHP project for the DevSecOps class",
  "require": {
    "php": ">=8.2.0",
    "ext-gd": "*",
    "nesbot/carbon": "^2.72.1",
    "vlucas/phpdotenv": "^5.6.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^10.3.2",
    "phpmetrics/phpmetrics": "^2.11",
    "phpmd/phpmd": "^3.0",
    "niels-de-blaauw/php-doc-check": "^0.4.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  }
}
