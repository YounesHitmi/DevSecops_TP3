<?xml version="1.0"?>
<ruleset name="DevSecOps TP3"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>PHPMD rules for the project, with documented exceptions.</description>

    <!-- These 4 rulesets are used as they are -->
    <rule ref="rulesets/cleancode.xml"/>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/unusedcode.xml"/>

    <!-- Superglobals: vlucas/phpdotenv puts the .env variables in $_ENV,
         that's how the library is meant to be used. -->
    <rule ref="rulesets/controversial.xml">
        <exclude name="Superglobals"/>
    </rule>

    <!-- ShortVariable: allow only "$im", the usual name for a GD image. -->
    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
    </rule>
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="exceptions" value="im"/>
        </properties>
    </rule>
</ruleset>
